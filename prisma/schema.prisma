generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Native Postgres enums (user_role / user_status). Roles and statuses are
// uppercase at the database level and throughout the application.
enum UserRole {
  ADMIN
  TEACHER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  // Optional: Google-authenticated users (all admins) have no local password.
  // Credential login (teachers, transitional) still uses this bcrypt hash.
  password      String?
  role          UserRole
  // Gates login regardless of role. Disabled accounts are denied at sign-in
  // and in middleware without being deleted.
  status        UserStatus     @default(ACTIVE)
  // Teacher profile fields, populated via the admin Teacher Management module.
  subject         String?
  assignedClass   String?
  assignedSection String?
  phone           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  exams         Exam[]
  auditLogs     AuditLog[]
  teacherAlerts TeacherAlert[]

  @@index([role, status])
}

model Student {
  id              Int            @id @default(autoincrement())
  admissionNumber String         @unique
  name            String
  class           String         // "8" | "9" | "10"
  section         String         // "A" | "B" | "C"
  parentPhone     String
  rollNumber      String?
  // "ACTIVE" | "INACTIVE" — deactivated students are retained (marks/history
  // preserved) but hidden from default rosters and excluded from sends.
  status          String         @default("ACTIVE")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  marks           Mark[]
  resultTokens    ResultToken[]
  notifications   Notification[]

  // Filter-first roster: class+section is the common filter, status gates it.
  @@index([class, section])
  @@index([status])
}

// status: "draft" | "pending_approval" | "published" | "rejected"
model Exam {
  id           Int           @id @default(autoincrement())
  name         String        // "FA-1" | "FA-2" | "SA-1" | "SA-2"
  class        String
  section      String
  status       String        @default("draft")
  uploadedById Int
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  rejectNote   String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  marks         Mark[]
  resultTokens  ResultToken[]
  auditLogs     AuditLog[]
  teacherAlerts TeacherAlert[]
  notifications Notification[]
}

model Mark {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  examId    Int
  exam      Exam     @relation(fields: [examId], references: [id])
  subject   String
  value     String   // "85" or "AB" for absent

  @@unique([studentId, examId, subject])
}

model ResultToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  examId    Int
  exam      Exam     @relation(fields: [examId], references: [id])
  createdAt DateTime @default(now())

  // Exactly one token per student per exam — makes publish idempotent and
  // race-safe, and indexes the (examId, studentId) lookup used when sending.
  @@unique([examId, studentId])
}

// channel: "sms"
// status: "pending" | "sent" | "delivered" | "failed" | "skipped"
// type:   "result" | "attendance" | "announcement"
model Notification {
  id           Int       @id @default(autoincrement())
  studentId    Int
  student      Student   @relation(fields: [studentId], references: [id])
  examId       Int?
  exam         Exam?     @relation(fields: [examId], references: [id])
  type         String    @default("result")
  channel      String
  status       String    @default("pending")
  providerSid  String?   // Twilio message SID
  toNumber     String?   // actual E.164 number the message was sent to
  errorCode    String?   // Twilio error code on failure
  errorMessage String?   // human-readable failure / fallback reason
  sentAt       DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  // Per-exam dispatch lookups (latest status per student, "already sent?" checks).
  @@index([examId, studentId, createdAt])
}

// Append-only audit of parents opening a result link. Written fire-and-forget
// from the result-access API so it never blocks the parent page.
model ResultAccessLog {
  id        Int      @id @default(autoincrement())
  token     String
  studentId Int
  examId    Int
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([examId, studentId])
  @@index([token])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  examId    Int?
  exam      Exam?    @relation(fields: [examId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String   // "upload" | "submit" | "approve" | "reject"
  note      String?
  createdAt DateTime @default(now())
}

// In-app alerts for teachers: created server-side when admin approves or rejects
// type: "approved" | "rejected"
model TeacherAlert {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  examId    Int
  exam      Exam     @relation(fields: [examId], references: [id])
  type      String   // "approved" | "rejected"
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
